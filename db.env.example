# Скопируйте этот файл в db.env и укажите адрес своей базы PostgreSQL.
# START.cmd прочитает db.env при запуске. Без db.env сайт работает с локальным файлом SQLite.
# Не добавляйте db.env в архив или git: в нём пароль от базы.

# База из docker compose (docker compose -p eventgo up -d db):
DATABASE_URL=postgres://eventgo:eventgo@127.0.0.1:5433/eventgo

# Своя установка PostgreSQL: создайте пустую базу и пользователя, таблицы и демо-данные создадутся сами.
# DATABASE_URL=postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@127.0.0.1:5432/eventgo
