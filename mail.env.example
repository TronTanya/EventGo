# Скопируйте этот файл в mail.env и впишите свои данные.
# START.cmd прочитает mail.env при запуске. Без mail.env почта работает в демо-режиме.
# Не добавляйте mail.env в архив или git: в нём пароль приложения.

# Яндекс 360 / Яндекс Почта: пароль приложения создаётся в id.yandex.ru → Безопасность → Пароли приложений
EVENTGO_SMTP_HOST=smtp.yandex.ru
EVENTGO_SMTP_PORT=465
EVENTGO_SMTP_USER=your-box@yandex.ru
EVENTGO_SMTP_PASS=пароль-приложения
EVENTGO_SMTP_FROM_NAME=EventGo

# Mail.ru: EVENTGO_SMTP_HOST=smtp.mail.ru, порт 465, пароль для внешних приложений
# Gmail: EVENTGO_SMTP_HOST=smtp.gmail.com, порт 587, пароль приложения Google
